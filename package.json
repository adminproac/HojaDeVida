{
  "name": "resume-admin",
  "version": "1.0.0",
  "scripts": {
    "start": "concurrently -k -n API,WEB -c blue,magenta \"npm:api\" \"npm:web:open\"",
    "serve": "concurrently -k -n API,WEB -c blue,magenta \"npm:api\" \"npm:web\"",
    "dev": "concurrently -k -n API,WEB -c blue,magenta \"npm:api:watch\" \"npm:web:open\"",
    "api": "node server/index.js",
    "api:watch": "node --watch server/index.js",
    "web": "wait-on -t 60000 tcp:127.0.0.1:3000 && ng serve",
    "web:open": "wait-on -t 60000 tcp:127.0.0.1:3000 && ng serve --open",
    "build": "ng build",
    "start:prod": "ng build && node server/index.js",
    "backup": "node scripts/backup.js",
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fortawesome/fontawesome-free": "^5.15.4",
    "bootstrap-icons": "^1.13.2",
    "express": "^5.3.0",
    "pdfjs-dist": "^5.4.296",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  },
  "description": "Administrador de hojas de vida (Angular + Node/Express + JSON) con la plantilla SB Admin 2 (Bootstrap 4, MIT)",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
