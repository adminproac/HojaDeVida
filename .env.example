# Copie este archivo a .env en la raíz del proyecto. .env no se sube a Git.
# Use una OAuth App distinta de la del sitio en vivo, con este callback:
#   http://localhost:4200/auth/callback
# El Client Secret solo va aquí (o en Cloudflare). Nunca en el código ni en el JSON.

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opcional. Logins de GitHub separados por coma. Vacío = cualquiera con permiso push.
GITHUB_ALLOWED_LOGINS=
